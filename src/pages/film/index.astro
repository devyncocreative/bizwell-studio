---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { films, img } from '../../lib/site';
const features = films.filter((f) => f.feature);
const event = films.find((f) => !f.feature)!;
const still = '2022_07_BizWell-Event-Screening-A-Going-Concern-06.22.mp4.00_00_46_09.Still001-1024x576.jpg';
---
<Base title="Films" description="Documentary films from Laurent Goldstein and Citrus Pie Media Group, including A Going Concern, the story of Alberta entrepreneur Gerry Levasseur.">
  <section class="phead"><div class="wrap">
    <p class="eyebrow">Films</p>
    <h1>Stories of purpose, told on film</h1>
    <p>Our films include interviews with top experts in self-improvement, health, science, art, spirituality, and business growth.</p>
  </div></section>
  <section class="sec"><div class="wrap films">
    {features.map((f) => (
      <article class="film">
        <a class="film__media" href={`/film/${f.slug}/`} tabindex="-1" aria-hidden="true">
          {img(`yt_${f.yt}.jpg`) ? <Image src={img(`yt_${f.yt}.jpg`)!} alt="" widths={[500, 900]} sizes="(max-width: 820px) 100vw, 520px" /> : <span class="card__blank"></span>}
        </a>
        <div class="film__body">
          <p class="eyebrow">Documentary{f.year && ` · ${f.year}`}</p>
          <h2><a href={`/film/${f.slug}/`}>{f.title}</a></h2>
          <p class="film__sub">{f.subtitle}</p>
          <p>{f.logline}</p>
          <a class="btn btn--pink" href={`/film/${f.slug}/`}>{f.yt ? 'Watch the trailer' : 'About the film'}</a>
        </div>
      </article>
    ))}
  </div></section>
  <section class="sec band"><div class="wrap split">
    <a href={`/film/${event.slug}/`}><Image src={img(still)!} alt="Audience at the Edmonton screening of A Going Concern" widths={[600, 1024]} sizes="(max-width: 820px) 100vw, 560px" style="border-radius:16px" /></a>
    <div>
      <p class="eyebrow">Screening event · 2022</p>
      <h2>{event.title}</h2>
      <p>{event.logline}</p>
      <a class="btn btn--line" href={`/film/${event.slug}/`}>See the event</a>
    </div>
  </div></section>
</Base>

---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Share from '../components/Share.astro';
import { blog, img, fmtDate } from '../lib/site';
export function getStaticPaths() { return blog.map((post) => ({ params: { slug: post.slug }, props: { post } })); }
const { post } = Astro.props;
const pic = img(post.img);
---
<Base title={post.title} description={post.excerpt} ogSrc={pic}>
  <section class="phead" style={pic ? 'padding-bottom:6rem' : ''}><div class="wrap">
    <p class="crumb"><a href="/blog/">Blog</a> /</p>
    <p class="eyebrow">{fmtDate(post.date)}</p>
    <h1 style="max-width:26ch">{post.title}</h1>
  </div></section>
  {pic && <div class="narrow overlap"><div class="yt"><Image src={pic} alt="" widths={[640, 1024]} sizes="(max-width: 900px) 100vw, 820px" loading="eager" /></div></div>}
  <section class="sec sec--tight"><div class="narrow prose">
    <Share title={post.title} />
    <Fragment set:html={post.html} />
    <p style="margin-top:2rem"><a class="btn btn--line" href="/blog/">All articles</a></p>
  </div></section>
</Base>

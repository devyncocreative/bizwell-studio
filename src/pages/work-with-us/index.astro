---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import { Image } from 'astro:assets';
import { img, films, library } from '../../lib/site';
const agc = films.find((f) => f.slug === 'a-going-concern')!;
const picks = library.filter((i) => i.yt && i.img).slice(0, 3);
---
<Base title="Hire Us" description="Consulting and content creation from the team behind BizWell Studio, through Citrus Pie Media Group.">
  <section class="phead"><div class="wrap">
    <p class="eyebrow">Hire us</p>
    <h1>Consulting and content creation</h1>
    <p>Are you looking for ways to grow your business by leveraging the best methods available online?</p>
  </div></section>
  <section class="sec"><div class="wrap split">
    <div>
      <h2>A “one stop shop” platform for entrepreneurs</h2>
      <p class="lede">This is why we created BizWell Studio.</p>
      <p>The films, interviews and business stories on this site were made by the BizWell Studio team with Citrus Pie Media Group. To talk about consulting or content for your own business, head over to Citrus Pie.</p>
      <div class="btns"><a class="btn btn--pink" href="https://citruspie.com/" rel="noopener" target="_blank">Go to CitrusPie.com</a><a class="btn btn--line" href="/contact-us/">Contact BizWell Studio</a></div>
    </div>
    <a href="/film/a-going-concern/"><Image src={img(`yt_${agc.yt}.jpg`)!} alt="Still from the A Going Concern trailer" widths={[600, 1024]} sizes="(max-width: 820px) 100vw, 560px" style="border-radius:16px" /></a>
  </div></section>
  <section class="sec band"><div class="wrap">
    <div class="sechead"><div><p class="eyebrow">Our work</p><h2>See what we make</h2></div><div class="btns"><a class="btn btn--line" href="/film/">Films</a><a class="btn btn--line" href="/library/">Library</a></div></div>
    <div class="grid grid--3">{picks.map((i) => <Card item={i} />)}</div>
  </div></section>
</Base>

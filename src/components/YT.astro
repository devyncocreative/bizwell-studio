---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { id: string; title: string; poster?: ImageMetadata; label?: string; eager?: boolean }
const { id, title, poster, label = 'Play video', eager = false } = Astro.props;
---
<div class="yt" data-yt={id} data-title={title}>
  {poster
    ? <Image src={poster} alt="" widths={[640, 1024]} sizes="(max-width: 900px) 100vw, 900px" loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} />
    : <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />}
  <button type="button" class="yt__btn" aria-label={`${label}: ${title}`}>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
  </button>
</div>

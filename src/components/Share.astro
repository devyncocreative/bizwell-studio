---
import * as icons from 'simple-icons';
const { title } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const u = encodeURIComponent(url), t = encodeURIComponent(title);
const path = (k: string) => (icons as any)[k].path;
const links = [
  ['Facebook', 'siFacebook', `https://www.facebook.com/sharer/sharer.php?u=${u}`],
  ['LinkedIn', 'siLinkedin', `https://www.linkedin.com/sharing/share-offsite/?url=${u}`],
  ['X', 'siTwitter', `https://twitter.com/intent/tweet?url=${u}&text=${t}`],
];
---
<div class="share" data-url={url} data-title={title}>
  <span class="share__label">Share</span>
  {links.map(([n, i, h]) => (
    <a class="share__a" href={h} target="_blank" rel="noopener" aria-label={`Share on ${n}`}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={path(i)} /></svg>
    </a>
  ))}
  <a class="share__a" href={`mailto:?subject=${t}&body=${u}`} aria-label="Share by email">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M3 6h18v12H3z M3 7l9 6 9-6" /></svg>
  </a>
  <button class="share__a share__copy" type="button" aria-label="Copy link">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1 M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg>
    <span class="share__done" aria-live="polite"></span>
  </button>
</div>

---
import { Image } from 'astro:assets';
import { img, itemHref, kindLabel, slugify } from '../lib/site';
const { item } = Astro.props;
const pic = img(item.img) || (item.yt ? img(`yt_${item.yt}.jpg`) : undefined);
---
<article class="card" data-kind={item.kind} data-topics={item.topics.map(slugify).join(' ')} data-text={(item.title + ' ' + item.places.join(' ') + ' ' + item.topics.join(' ')).toLowerCase()}>
  <a class="card__media" href={itemHref(item)} tabindex="-1" aria-hidden="true">
    {pic ? <Image src={pic} alt="" widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" loading="lazy" />
      : item.yt ? <img src={`https://i.ytimg.com/vi/${item.yt}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" />
      : <span class="card__blank"></span>}
    {item.yt && <span class="card__play"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>}
  </a>
  <div class="card__body">
    <p class="eyebrow">{kindLabel(item.kind)}{item.topics[0] && <> · {item.topics[0]}</>}</p>
    <h3><a href={itemHref(item)}>{item.title}</a></h3>
    <p class="card__ex">{item.excerpt}</p>
  </div>
</article>

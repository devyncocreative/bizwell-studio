---
import Base from '../layouts/Base.astro';
import YT from './YT.astro';
import Card from './Card.astro';
import Share from './Share.astro';
import { Image } from 'astro:assets';
import { library, img, fmtDate, kindLabel, slugify } from '../lib/site';
const { item } = Astro.props;
const pic = img(item.img);
const related = library.filter((i) => i.slug !== item.slug && (item.kind === 'podcast' ? i.kind === 'podcast' : i.topics.some((t: string) => item.topics.includes(t)))).slice(0, 3);
---
<Base title={item.title} description={item.excerpt} ogSrc={pic}>
  <section class="phead" style="padding-bottom:6rem"><div class="wrap">
    <p class="crumb"><a href="/library/">Library</a> / <a href={`/library/?type=${item.kind}`}>{item.kind === 'podcast' ? 'Interviews' : 'Business stories'}</a> /</p>
    <p class="eyebrow">{kindLabel(item.kind)}</p>
    <h1>{item.title}</h1>
  </div></section>
  <div class="narrow overlap">
    {item.yt ? <YT id={item.yt} title={item.title} poster={pic} />
      : pic ? <div class="yt"><Image src={pic} alt="" widths={[640, 1024]} sizes="(max-width: 900px) 100vw, 820px" /></div> : null}
  </div>
  <section class="sec sec--tight"><div class="narrow prose">
    <ul class="meta">
      <li>{fmtDate(item.date)}</li>
      {item.topics.map((t: string) => <li><a href={`/library/?topic=${slugify(t)}`}>{t}</a></li>)}
      {item.places.map((p: string) => <li>{p}</li>)}
    </ul>
    <Share title={item.title} />
    {!item.yt && <p class="note">The video for this story isn't available right now.</p>}
    <Fragment set:html={item.html} />
  </div></section>
  {related.length > 0 && <section class="sec band"><div class="wrap">
    <div class="sechead"><h2>Keep watching</h2><a class="btn btn--line" href="/library/">Back to the library</a></div>
    <div class="grid">{related.map((i) => <Card item={i} />)}</div>
  </div></section>}
</Base>
